DB_HOST=localhost
DB_PORT=5432
DB_NAME=frequency
DB_USER=postgres
DB_PASSWORD=
SECRET_KEY=

# E-mail transacional para confirmação de novas academias (não use a conexão
# Gmail de prospecção). Se vazio, o cadastro fica pendente e o reenvio aguarda
# a configuração deste SMTP.
FREQUENCY_PUBLIC_URL=https://frequencygym.tech
FREQUENCY_SMTP_HOST=
FREQUENCY_SMTP_PORT=465
FREQUENCY_SMTP_USER=
FREQUENCY_SMTP_PASSWORD=
FREQUENCY_SMTP_FROM=

# Serviço local. 0.0.0.0 permite o acesso pela rede interna da academia.
FREQUENCY_HOST=0.0.0.0
FREQUENCY_PORT=8000
FREQUENCY_TLS_CERTFILE=
FREQUENCY_TLS_KEYFILE=

# Sincronização local para uma cópia de consulta na nuvem.
# Mantenha as opções em NO até migrar e validar em ambiente descartável.
FREQUENCY_INSTALLATION_MODE=local
SYNC_CLOUD_BASE_URL=https://frequencygym.tech
SYNC_OUTBOX_ENABLED=NO
SYNC_WORKER_ENABLED=NO
SYNC_RECEIVER_ENABLED=NO
SYNC_MIRROR_READ_ONLY=NO

# Preencher somente durante a implantação, usando HTTPS e arquivos protegidos.
SYNC_LOCAL_ACADEMY_ID=
SYNC_REMOTE_URL=
SYNC_REMOTE_TOKEN=
SYNC_WORKER_POLL_SECONDS=10

# Backup criptografado diário. Para guardar no próprio computador ou na pasta
# OneDrive sincronizada deste computador, use BACKUP_STORAGE_PROVIDER=local.
BACKUP_ENABLE=NO
BACKUP_STATUS_FILE=
BACKUP_LOCAL_DIR=
BACKUP_LOCAL_RETENTION_DAYS=7
BACKUP_REMOTE_RETENTION_DAYS=
BACKUP_S3_MAX_GB=90
BACKUP_STORAGE_PROVIDER=s3
BACKUP_NODE_ID=
BACKUP_AGE_RECIPIENT=
BACKUP_S3_BUCKET=
BACKUP_S3_PREFIX=frequency/backups
# Exemplo local: C:/Users/usuario/OneDrive/Frequency Backups
# BACKUP_STORAGE_PROVIDER=local
# BACKUP_LOCAL_DIR=
# GOOGLE_DRIVE_DIR=C:/Users/usuario/Google Drive
# AGE_BIN=
# PG_DUMP_BIN=
# Login opcional do OneDrive (OAuth Microsoft Entra; requer aplicativo próprio).
# ONEDRIVE_CLIENT_ID=
# ONEDRIVE_CLIENT_SECRET=
# ONEDRIVE_REDIRECT_URI=https://seu-host/operacao/backup/onedrive/callback

# Cobrança online (dLocal Payins, Bolívia). Ative somente depois de criar a
# conta comercial, configurar o webhook HTTPS e testar no sandbox. Nunca
# coloque estas chaves no frontend ou em documentação pública.
PAYMENT_PUBLIC_BASE_URL=https://frequencygym.tech
# Mantenha o Sandbox durante desenvolvimento; troque para https://api.dlocal.com somente no go-live.
DLOCAL_API_BASE_URL=https://sandbox.dlocal.com
DLOCAL_X_LOGIN=
DLOCAL_X_TRANS_KEY=
DLOCAL_SECRET_KEY=
DLOCAL_COUNTRY=BO
DLOCAL_PAYMENT_METHOD_ID=QR
DLOCAL_PAYMENT_FLOW=REDIRECT

# Prospecção WhatsApp via Meta Cloud API. O envio só aceita leads com whatsapp_opt_in=true.
WHATSAPP_CLOUD_API_VERSION=v23.0
WHATSAPP_CLOUD_API_TOKEN=
WHATSAPP_CLOUD_PHONE_NUMBER_ID=
WHATSAPP_CLOUD_BUSINESS_ACCOUNT_ID=
WHATSAPP_CLOUD_TEMPLATE_NAME=
WHATSAPP_CLOUD_TEMPLATE_LANGUAGE=es
# Apenas para testes locais em 127.0.0.1; nunca habilite em produção.
# PAYMENT_ALLOW_HTTP_STAGING=YES
